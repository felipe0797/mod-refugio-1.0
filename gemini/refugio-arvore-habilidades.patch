+                if (isActive(player, "burst")) {
+                    activateBurst(player, true);
+                }
+            }
+            case "BURST_EXPLICIT" -> {
+                if (isActive(player, "burst")) {
+                    activateBurst(player, true);
+                } else {
+                    sendNoMovementSkillMessage(player);
+                }
+            }
+            default -> {
+                boolean activated = false;
+                if (isActive(player, "super_jump")) activated |= activateSuperJump(player);
