+    public static int coinsForMilestone(int milestoneNumber) {
+        if (milestoneNumber < 1 || milestoneNumber > TOTAL_MILESTONES) {
+            return 0;
+        }
+        return 50 + 15 * (milestoneNumber - 1);
+    }
